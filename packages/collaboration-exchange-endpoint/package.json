{
  "name": "@univerjs-pro/collaboration-exchange-endpoint",
  "version": "0.0.0",
  "description": "HTTP import and export routes of the Univer frontend for the Univer Collaboration Exchange Service",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dream-num/univer-collaboration-sdk-community.git",
    "directory": "packages/collaboration-exchange-endpoint"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "@univerjs-pro/collaboration-exchange-service": "workspace:*",
    "@univerjs-pro/collaboration-file-service": "workspace:*",
    "@univerjs-pro/collaboration-service": "1.3.1",
    "@univerjs-pro/collaboration-transport-node": "1.3.1",
    "@univerjs/protocol": "1.3.1"
  },
  "devDependencies": {
    "@univerjs-pro/collaboration-database-memory": "workspace:*",
    "@univerjs-pro/collaboration-exchange-service": "workspace:*",
    "@univerjs-pro/collaboration-file-memory": "workspace:*",
    "@univerjs-pro/collaboration-file-service": "workspace:*",
    "@univerjs-pro/collaboration-service": "1.3.1",
    "@univerjs-pro/collaboration-transport-node": "1.3.1",
    "@univerjs-pro/exchange-node": "1.3.1",
    "@univerjs/protocol": "1.3.1"
  }
}
