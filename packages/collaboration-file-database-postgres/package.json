{
  "name": "@univerjs-pro/collaboration-file-database-postgres",
  "version": "0.0.0",
  "description": "PostgreSQL IFileDatabaseAdapter for Univer Collaboration built on node-postgres",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dream-num/univer-collaboration-sdk-community.git",
    "directory": "packages/collaboration-file-database-postgres"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "@univerjs-pro/collaboration-file-service": "workspace:*",
    "pg": "^8.11.0"
  },
  "devDependencies": {
    "@univerjs-pro/collaboration-file-service": "workspace:*",
    "@types/pg": "^8.15.0",
    "@univerjs-pro/collaboration-file-database-testkit": "workspace:*",
    "pg": "^8.16.0"
  }
}
