    "coverage": "vitest run --coverage --passWithNoTests"
  },
  "peerDependencies": {
    "@univerjs-pro/collaboration-history-service": "1.3.1",
    "@univerjs/protocol": "1.3.1",
    "vitest": ">=4.1.0"
  },
