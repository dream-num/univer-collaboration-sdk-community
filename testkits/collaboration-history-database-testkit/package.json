{
  "name": "@univerjs-pro/collaboration-history-database-testkit",
  "version": "0.0.0",
  "description": "Contract tests for Univer Collaboration IHistoryDatabaseAdapter implementations",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dream-num/univer-collaboration-sdk-community.git",
    "directory": "testkits/collaboration-history-database-testkit"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts"
  },
